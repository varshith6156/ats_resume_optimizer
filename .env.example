# ATS Resume Optimizer - Environment Configuration
# Copy this file to .env.local and add your API key

# Choose your preferred LLM provider (Gemini or OpenAI)
# Option 1: Google Gemini (Recommended - free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini Model (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
# Optional OpenAI Model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Groq API Key (for ultra-fast Llama-3 inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
